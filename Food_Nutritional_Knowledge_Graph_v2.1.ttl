@prefix : <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph/> .

<http://www.semanticweb.org/as/ontologies/2026/6/Food_Nutrition_Graph> rdf:type owl:Ontology ;
    owl:versionInfo "2.1 (2026-11-21)" ;
    rdfs:comment """Bangladeshi Food Ontology for nutritional-risk estimation and local food recommendation.
VERSION 2.0 CHANGES:
(1) FOOD VALUES: every food except those flagged :notInFCT now takes its per-100 g values from the
    Food Composition Table for Bangladesh (INFS, University of Dhaka, 2013), with the FCT food code in
    :hasFCTCode and the FCT English name in :hasFCTName. Values are per 100 g EDIBLE portion, as eaten
    for boiled*/recipe items and RAW for meat/fish (FCT has no cooked values for most of them).
(2) MISSING IS NOT ZERO: a blank FCT cell is NOT asserted as 0. It is recorded with :hasUnknownValueFor.
    FCT 'Tr' (trace) is stored as 0.0 and marked :hasTraceValueFor. FCT values in [brackets]
    (alternative method / low quality) are stored and marked :hasLowQualityValueFor.
(3) ONE REFERENCE: all nutrient requirements use ICMR-NIN 2020 (EAR and RDA, adult man 65 kg / woman 55 kg),
    except Carbohydrate (IOM; see its comment). Use EAR for risk of inadequate intake (EAR cut-point
    method) and RDA as the target for recommendations.
(4) ABSORPTION: :inhibitsAbsorption added (tea/coffee polyphenols -> iron; phytate-rich cereals/legumes ->
    iron, zinc). ICMR-NIN iron/zinc requirements already assume low-bioavailability diets, so these
    links should be used for EXPLANATION and meal-pairing advice, not to subtract intake a second time.
(5) DERIVED LINKS: :hasNutrient / :isGoodSourceOf are generated by rule (per serving >= 10% / >= 15% of the
    adult-woman RDA). Serving sizes for foods added in v2 are household estimates (see :servingSizeSource).
(6) SYMPTOM INFERENCE: :mayHelpWithSymptom is a property chain (isGoodSourceOf o causesSymptom). It states
    a POSSIBLE dietary link, not a diagnosis.
VERSION 2.1 CHANGES (constraints so that a reasoner consistency check is meaningful):
(7) DISJOINTNESS: Food, Nutrient, Symptom and Religion are pairwise disjoint; the main food groups
    (Grain, Legume, Vegetable, Fruit, Meat, Fish, Egg, Dairy, Oil, Sweetener, JunkFood, Beverage) are pairwise
    disjoint; GreenLeafy/OtherVegetable, CitrusFruit/OtherFruit and Macronutrient/Micronutrient are disjoint.
    MixedDish is deliberately NOT disjoint with the groups (a dish can be decomposed into several groups).
(8) FUNCTIONAL DATA PROPERTIES: every data property is functional, so one food cannot carry two different
    values for the same nutrient, code or serving size.
(9) VALUE RANGES: per-100 g composition values must be >= 0; serving sizes and EAR/RDA values must be > 0
    (OWL 2 datatype restrictions on xsd:float).
(10) IDENTITY: :Food owl:hasKey ( :hasFCTCode ) — two foods with the same FCT code are the same food; and all
    named individuals are declared owl:AllDifferent. Together: a duplicated FCT code makes the ontology
    inconsistent instead of silently merging two foods."""@en .


#################################################################
#    Object Properties
#################################################################

###  causesSymptom
:causesSymptom rdf:type owl:ObjectProperty ;
               rdfs:domain :Nutrient ;
               rdfs:range :Symptom ;
               rdfs:comment "Links a nutrient to a symptom that its deficiency can cause. Symptoms are non-specific (many causes); use as context, not as a label."@en .


###  hasNutrient
:hasNutrient rdf:type owl:ObjectProperty ;
             rdfs:domain :Food ;
             rdfs:range :Nutrient ;
             rdfs:comment "Food is a SOURCE of the nutrient: one serving gives >= 10% of the adult-woman ICMR-NIN 2020 RDA (Fat: >= 5 g per serving). Generated by rule from FCT values."@en .


###  isGoodSourceOf
:isGoodSourceOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasNutrient ;
                rdfs:domain :Food ;
                rdfs:range :Nutrient ;
                rdfs:comment "Food is a GOOD SOURCE of the nutrient: one serving gives >= 15% of the adult-woman ICMR-NIN 2020 RDA (mirrors the Codex 'source of' 15% convention). Generated by rule from FCT values."@en .


###  hasGoodFoodSource
:hasGoodFoodSource rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isGoodSourceOf ;
                   rdfs:domain :Nutrient ;
                   rdfs:range :Food ;
                   rdfs:comment "Inverse of :isGoodSourceOf (Nutrient -> Food). Replaces the v1 property :treatedBy."@en .


###  treatedBy  (kept only for backward compatibility with v1 queries)
:treatedBy rdf:type owl:ObjectProperty ;
           owl:equivalentProperty :hasGoodFoodSource ;
           owl:deprecated "true"^^xsd:boolean ;
           rdfs:comment "DEPRECATED in v2: 'treated by' sounds clinical. Use :hasGoodFoodSource. Kept equivalent so old SPARQL/DL queries still work."@en .


###  enhancesAbsorption
:enhancesAbsorption rdf:type owl:ObjectProperty ;
                    rdfs:domain :Food ;
                    rdfs:range :Nutrient ;
                    rdfs:comment "Eating this food in the SAME MEAL increases absorption of the nutrient (from other foods). v2 rules: vitamin C >= 25 mg per serving -> Iron; meat and fish (the 'meat/fish factor') -> non-haem Iron."@en .


###  inhibitsAbsorption
:inhibitsAbsorption rdf:type owl:ObjectProperty ;
                    rdfs:domain :Food ;
                    rdfs:range :Nutrient ;
                    rdfs:comment "Eating this food in the SAME MEAL reduces absorption of the nutrient (from other foods). v2: tea/coffee polyphenols -> Iron; phytate-rich cereals and legumes -> Iron, Zinc (phytate values: FCT 2013 Annex 4). Because ICMR-NIN requirements already assume a low-bioavailability diet, use for explanation and meal-timing advice (e.g. tea 1 h away from meals), not for a second numeric deduction."@en .


###  mayHelpWithSymptom  (inferred)
:mayHelpWithSymptom rdf:type owl:ObjectProperty ;
                    owl:propertyChainAxiom ( :isGoodSourceOf :causesSymptom ) ;
                    rdfs:domain :Food ;
                    rdfs:range :Symptom ;
                    rdfs:comment "INFERRED by an OWL 2 reasoner (e.g. HermiT in Protégé): Food isGoodSourceOf Nutrient, Nutrient causesSymptom Symptom => Food mayHelpWithSymptom Symptom. Means 'a possible dietary link', never a diagnosis or treatment claim."@en .


###  restrictedByReligion
:restrictedByReligion rdf:type owl:ObjectProperty ;
                      rdfs:domain :Food ;
                      rdfs:range :Religion ;
                      rdfs:comment "Links a food to a religion whose followers commonly avoid it. A simplification: individual practice varies. Prefer asking the person directly; treat as a default, not a rule."@en .


###  hasUnknownValueFor
:hasUnknownValueFor rdf:type owl:ObjectProperty ;
                    rdfs:domain :Food ;
                    rdfs:range :Nutrient ;
                    rdfs:comment "The FCT cell for this nutrient is blank (missing). The nutrient engine must treat it as UNKNOWN (report as missing / reduce confidence), never as zero."@en .


###  hasTraceValueFor
:hasTraceValueFor rdf:type owl:ObjectProperty ;
                  rdfs:domain :Food ;
                  rdfs:range :Nutrient ;
                  rdfs:comment "The FCT reports 'Tr' (trace) for this nutrient; the stored numeric value is 0.0."@en .


###  hasLowQualityValueFor
:hasLowQualityValueFor rdf:type owl:ObjectProperty ;
                       rdfs:domain :Food ;
                       rdfs:range :Nutrient ;
                       rdfs:comment "The FCT value is in [brackets]: alternative analytical method or low quality, to be reconfirmed (FCT 2013, Symbols)."@en .


#################################################################
#    Data properties
#################################################################

###  hasEnergy_kcal_per_100g
:hasEnergy_kcal_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT ENERC (kcal) per 100 g edible portion."@en .

###  hasProteinContent_g_per_100g
:hasProteinContent_g_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT PROT."@en .

###  hasFatContent_g_per_100g
:hasFatContent_g_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT FATCE (fat by Soxhlet)."@en .

###  hasCarbohydrate_g_per_100g
:hasCarbohydrate_g_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT CHOAVLDF (available carbohydrate by difference)."@en .

###  hasDietaryFibre_g_per_100g
:hasDietaryFibre_g_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT FIBTG or [FIBC]."@en .

###  hasCalcium_mg_per_100g
:hasCalcium_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT CA."@en .

###  hasIronContent_mg_per_100g
:hasIronContent_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT FE."@en .

###  hasZincContent_mg_per_100g
:hasZincContent_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT ZN."@en .

###  hasVitaminA_mcg_per_100g
:hasVitaminA_mcg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT VITA_RAE (retinol activity equivalents)."@en .

###  hasVitaminC_mg_per_100g
:hasVitaminC_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT ASCL."@en .

###  hasVitaminD_mcg_per_100g
:hasVitaminD_mcg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT VITD."@en .

###  hasFolate_mcg_per_100g
:hasFolate_mcg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT FOL (total food folate)."@en .

###  hasPhytate_mg_per_100g
:hasPhytate_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT Annex 4 PHYTAC. Only asserted when the food's own FCT code is in Annex 4."@en .

###  hasOxalate_mg_per_100g
:hasOxalate_mg_per_100g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "FCT Annex 4 OXALAC. Only asserted when the food's own FCT code is in Annex 4."@en .

###  hasServingSize_g
:hasServingSize_g rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "Weight of one typical serving (or of one natural unit if :hasNaturalUnitLabel is set). Not from FCT; see :servingSizeSource."@en .

###  hasNaturalUnitLabel
:hasNaturalUnitLabel rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:string ;
    rdfs:comment "Human-friendly countable unit (e.g. 'টি (ডিম)'); :hasServingSize_g is the weight of ONE such unit."@en .

###  hasFCTCode
:hasFCTCode rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:string ;
    rdfs:comment "INFS Food Composition Table for Bangladesh (2013) food code."@en .

###  hasFCTName
:hasFCTName rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:string ;
    rdfs:comment "English food name exactly as printed in the FCT. A trailing * means recipe calculation."@en .

###  isRecipeCalculated
:isRecipeCalculated rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when the FCT value is a recipe calculation (* in FCT), not a direct analysis."@en .

###  valueBasis
:valueBasis rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:string ;
    rdfs:comment "Physical state the per-100 g values refer to (e.g. boiled, raw)."@en .

###  servingSizeSource
:servingSizeSource rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:string ;
    rdfs:comment "Where :hasServingSize_g came from."@en .

###  notInFCT
:notInFCT rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Food ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when the food is not in the INFS FCT 2013 and values come from elsewhere. Replace before publication."@en .

###  hasEAR_male_daily
:hasEAR_male_daily rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "ICMR-NIN 2020 Estimated Average Requirement, adult man (65 kg). Use for risk of inadequate intake."@en .

###  hasEAR_female_daily
:hasEAR_female_daily rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "ICMR-NIN 2020 Estimated Average Requirement, adult non-pregnant non-lactating woman (55 kg)."@en .

###  hasRDA_male_daily
:hasRDA_male_daily rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "ICMR-NIN 2020 Recommended Dietary Allowance, adult man. Use as the recommendation target."@en .

###  hasRDA_female_daily
:hasRDA_female_daily rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range [ rdf:type rdfs:Datatype ;
        owl:onDatatype xsd:float ;
        owl:withRestrictions ( [ xsd:minExclusive "0.0"^^xsd:float ] ) ] ;
    rdfs:comment "ICMR-NIN 2020 Recommended Dietary Allowance, adult woman."@en .

###  hasRequirementUnit
:hasRequirementUnit rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range xsd:string ;
    rdfs:comment "Unit of the EAR/RDA values."@en .

###  hasReferenceSource
:hasReferenceSource rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Nutrient ;
    rdfs:range xsd:string ;
    rdfs:comment "Bibliographic source of the EAR/RDA values."@en .


#################################################################
#    Classes
#################################################################

:Food rdf:type owl:Class .

:Grain rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Cereals and cereal products (FCT group 01)."@en .
:Legume rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Pulses (FCT group 02); also covers nuts/seeds (FCT group 06) for simplicity."@en .
:Vegetable rdf:type owl:Class ; rdfs:subClassOf :Food .
:GreenLeafy rdf:type owl:Class ; rdfs:subClassOf :Vegetable ;
    rdfs:comment "Leafy vegetables (FCT group 04)."@en .
:OtherVegetable rdf:type owl:Class ; rdfs:subClassOf :Vegetable ;
    rdfs:comment "Other vegetables (FCT group 03) and starchy roots/tubers (FCT group 05)."@en .
:Fruit rdf:type owl:Class ; rdfs:subClassOf :Food .
:CitrusFruit rdf:type owl:Class ; rdfs:subClassOf :Fruit .
:OtherFruit rdf:type owl:Class ; rdfs:subClassOf :Fruit .
:Meat rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Meat, poultry and organ meat (FCT group 10). FCT values are RAW; convert cooked weight before use."@en .
:Fish rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Fish and shellfish (FCT group 09). Most FCT values are RAW edible portion; convert cooked weight before use."@en .
:Egg rdf:type owl:Class ; rdfs:subClassOf :Food .
:Dairy rdf:type owl:Class ; rdfs:subClassOf :Food .
:Oil rdf:type owl:Class ; rdfs:subClassOf :Food .
:MixedDish rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Multi-ingredient recipe dish with an FCT recipe calculation (*). For WHO dietary-diversity scoring, decompose into ingredients."@en .
:Sweetener rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Sugar and jaggery. Lifestyle tracking, excluded from WHO DDS scoring."@en .
:JunkFood rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Lifestyle-tracking category, excluded from WHO DDS scoring."@en .
:Beverage rdf:type owl:Class ; rdfs:subClassOf :Food ;
    rdfs:comment "Tea, coffee and other drinks. Lifestyle-tracking category, excluded from WHO DDS scoring."@en .

:Nutrient rdf:type owl:Class .
:Macronutrient rdf:type owl:Class ; rdfs:subClassOf :Nutrient .
:Micronutrient rdf:type owl:Class ; rdfs:subClassOf :Nutrient .
:Symptom rdf:type owl:Class .
:Religion rdf:type owl:Class ;
    rdfs:comment "Used only to flag common food avoidances as a helpful default; not a claim about any individual's actual practice."@en .


#################################################################
#    Constraint axioms (v2.1)
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Food :Nutrient :Symptom :Religion ) ] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Grain :Legume :Vegetable :Fruit :Meat :Fish :Egg :Dairy :Oil :Sweetener :JunkFood :Beverage ) ] .

:GreenLeafy owl:disjointWith :OtherVegetable .
:CitrusFruit owl:disjointWith :OtherFruit .
:Macronutrient owl:disjointWith :Micronutrient .

:Food owl:hasKey ( :hasFCTCode ) .


#################################################################
#    Individuals — Nutrients (ICMR-NIN 2020 EAR + RDA)
#################################################################

:Protein rdf:type owl:NamedIndividual , :Macronutrient ;
    :hasEAR_male_daily "42.9"^^xsd:float ;
    :hasEAR_female_daily "36.3"^^xsd:float ;
    :hasRDA_male_daily "54.0"^^xsd:float ;
    :hasRDA_female_daily "45.7"^^xsd:float ;
    :hasRequirementUnit "g/day" ;
    :hasReferenceSource "ICMR-NIN 2020 (0.66 g/kg EAR, 0.83 g/kg RDA; ref. body weight 65 kg man / 55 kg woman)" .

:Carbohydrate rdf:type owl:NamedIndividual , :Macronutrient ;
    :hasEAR_male_daily "100.0"^^xsd:float ;
    :hasEAR_female_daily "100.0"^^xsd:float ;
    :hasRDA_male_daily "130.0"^^xsd:float ;
    :hasRDA_female_daily "130.0"^^xsd:float ;
    :hasRequirementUnit "g/day" ;
    :hasReferenceSource "IOM/NASEM DRI — EXCEPTION: not given in the ICMR-NIN 2020 brief note; verify against the ICMR-NIN 2020 full report" .

:Calcium rdf:type owl:NamedIndividual , :Micronutrient ;
    :hasEAR_male_daily "800.0"^^xsd:float ;
    :hasEAR_female_daily "800.0"^^xsd:float ;
    :hasRDA_male_daily "1000.0"^^xsd:float ;
    :hasRDA_female_daily "1000.0"^^xsd:float ;
    :hasRequirementUnit "mg/day" ;
    :hasReferenceSource "ICMR-NIN 2020" ;
    :causesSymptom :BoneJointPain .

:Iron rdf:type owl:NamedIndividual , :Micronutrient ;
    :hasEAR_male_daily "11.0"^^xsd:float ;
    :hasEAR_female_daily "15.0"^^xsd:float ;
    :hasRDA_male_daily "19.0"^^xsd:float ;
    :hasRDA_female_daily "29.0"^^xsd:float ;
    :hasRequirementUnit "mg/day" ;
    :hasReferenceSource "ICMR-NIN 2020 (requirement already assumes the low iron bioavailability of South Asian, cereal-based diets)" ;
    :causesSymptom :Fatigue , :HairLoss , :PoorConcentration , :PaleConjunctiva , :Koilonychia .

:Zinc rdf:type owl:NamedIndividual , :Micronutrient ;
    :hasEAR_male_daily "14.0"^^xsd:float ;
    :hasEAR_female_daily "11.0"^^xsd:float ;
    :hasRDA_male_daily "17.0"^^xsd:float ;
    :hasRDA_female_daily "13.0"^^xsd:float ;
    :hasRequirementUnit "mg/day" ;
    :hasReferenceSource "ICMR-NIN 2020 (requirement already assumes a phytate-rich diet)" ;
    :causesSymptom :HairLoss , :FrequentIllness .

:VitaminA rdf:type owl:NamedIndividual , :Micronutrient ;
    :hasEAR_male_daily "460.0"^^xsd:float ;
    :hasEAR_female_daily "390.0"^^xsd:float ;
    :hasRDA_male_daily "1000.0"^^xsd:float ;
    :hasRDA_female_daily "840.0"^^xsd:float ;
    :hasRequirementUnit "mcg/day" ;
    :hasReferenceSource "ICMR-NIN 2020 (expressed as retinol; FCT food values are RAE — check the carotene conversion factor before comparing)" ;
    :causesSymptom :NightBlindness , :DryFlakySkin .

:VitaminC rdf:type owl:NamedIndividual , :Micronutrient ;
    :hasEAR_male_daily "65.0"^^xsd:float ;
    :hasEAR_female_daily "55.0"^^xsd:float ;
    :hasRDA_male_daily "80.0"^^xsd:float ;
    :hasRDA_female_daily "65.0"^^xsd:float ;
    :hasRequirementUnit "mg/day" ;
    :hasReferenceSource "ICMR-NIN 2020" ;
    :causesSymptom :GumBleeding , :FrequentIllness .

