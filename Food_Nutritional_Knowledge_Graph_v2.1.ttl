#################################################################
#    Unique names (v2.1): every named individual is a distinct entity
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers (
    :Protein :Carbohydrate :Calcium :Iron :Zinc :VitaminA
    :VitaminC :VitaminD :Folate :Fat :Fatigue :HairLoss
    :GumBleeding :NightBlindness :DryFlakySkin :BoneJointPain :FrequentIllness :PoorConcentration
    :PaleConjunctiva :Koilonychia :Hinduism :Islam :Buddhism :Christianity
